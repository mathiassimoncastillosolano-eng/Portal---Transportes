# ==============================================================================
# Frontend (Vite). Copiar como .env en la raíz del proyecto.
# IMPORTANTE: las variables VITE_* se incrustan en el bundle que llega al navegador.
# NUNCA pongas aquí secretos (Access Token, contraseñas, claves privadas).
# ==============================================================================

# URL del backend (Spring Boot). En Vercel apunta a la URL pública de Render.
VITE_API_URL=http://localhost:8080

# Client ID de Google (es público, no es un secreto). Si se omite, se usa el de Transportes Auth.
VITE_GOOGLE_CLIENT_ID=634394270803-cq7r95msc42438ja1c5rf68v0ma1251i.apps.googleusercontent.com

# ------------------------------------------------------------------------------
# Mercado Pago (Checkout API vía Orders)
# ------------------------------------------------------------------------------
# Public Key de PRUEBA de tu aplicación (Tus integraciones > Credenciales > Prueba).
# Es pública por diseño; aun así, usa la de prueba hasta pasar a producción.
VITE_MERCADOPAGO_PUBLIC_KEY=APP_USR-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Modo Sandbox: muestra los datos de prueba en la pasarela. Pon false en producción.
VITE_MERCADOPAGO_SANDBOX=true
