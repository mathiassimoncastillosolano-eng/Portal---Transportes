# URL base del backend (Render). Vite solo expone al navegador variables con prefijo VITE_.
# Desarrollo local: backend en http://localhost:8080
# Producción (Vercel > Settings > Environment Variables): https://portal-transportes.onrender.com
# Sin barra final. No colocar secretos aquí: todo lo VITE_* es público en el bundle.
VITE_API_URL=http://localhost:8080

# Ventas que muestra el Dashboard del gerente: SANDBOX (compras de prueba, por defecto) o PRODUCTION (dinero real).
VITE_DASHBOARD_ENTORNO=SANDBOX
