# Copiar como backend/.env.properties y completar SOLO en el equipo local.
# Ejecutar Maven desde backend/ para que Spring encuentre este archivo.
# Este archivo de ejemplo no debe contener valores reales. backend/.env.properties está en .gitignore.

# --- Base de datos (Supabase / PostgreSQL, Transaction Pooler puerto 6543) ---
spring.datasource.url=jdbc:postgresql://aws-0-sa-east-1.pooler.supabase.com:6543/postgres?prepareThreshold=0&sslmode=require
spring.datasource.username=postgres.TU_PROYECTO
spring.datasource.password=REEMPLAZAR_CON_LA_CLAVE_DE_LA_BASE

# --- Seguridad: secretos aleatorios de al menos 32 bytes ---
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
security.jwt.clave-secreta=REEMPLAZAR_CON_UN_SECRETO_ALEATORIO_DE_AL_MENOS_32_BYTES
RESERVA_TOKEN_SECRETO=REEMPLAZAR_CON_UN_SECRETO_ALEATORIO_DE_AL_MENOS_32_BYTES
RECUPERACION_SECRETO=REEMPLAZAR_CON_UN_SECRETO_ALEATORIO_DE_AL_MENOS_32_BYTES

# --- Inicio de sesión con Google (opcional: ya trae el Client ID por defecto; no se usa Client Secret) ---
# google.client-id=634394270803-cq7r95msc42438ja1c5rf68v0ma1251i.apps.googleusercontent.com

# --- Recuperación de contraseña por correo (Resend) ---
RESEND_API_KEY=REEMPLAZAR_CON_TU_API_KEY_DE_RESEND
RESEND_FROM=RutaLibre <no-reply@tu-dominio-verificado.com>

# --- Consulta de DNI (ApiPeru). Solo en el servidor; nunca en variables VITE_* ---
DNI_API_TOKEN=REEMPLAZAR_CON_TU_TOKEN_DE_APIPERU

# ==============================================================================
# Mercado Pago (Checkout API vía Orders). Credenciales SEPARADAS por entorno.
# Los Access Tokens y las claves secretas NUNCA van al frontend. La Public Key sí es pública, pero el backend la
# entrega al navegador según el entorno elegido (GET /api/pagos/configuracion): no hay que duplicarla en Vercel.
# ==============================================================================

# ---------- SANDBOX (pruebas, sin dinero real) ----------
# Panel: Tus integraciones > tu aplicación > Credenciales > selector "Prueba". Empieza por APP_USR-.
# (Nombre anterior, aún válido: MERCADOPAGO_ACCESS_TOKEN / MERCADOPAGO_WEBHOOK_SECRET.)
MERCADOPAGO_SANDBOX_ACCESS_TOKEN=REEMPLAZAR_CON_TU_ACCESS_TOKEN_DE_PRUEBA
MERCADOPAGO_SANDBOX_PUBLIC_KEY=REEMPLAZAR_CON_TU_PUBLIC_KEY_DE_PRUEBA
MERCADOPAGO_SANDBOX_WEBHOOK_SECRET=REEMPLAZAR_CON_LA_CLAVE_SECRETA_DE_WEBHOOKS_DE_PRUEBA
# id_usuario (tabla usuario) que pueden pagar en Sandbox, separados por coma. Vacío = nadie puede usar Sandbox.
MERCADOPAGO_SANDBOX_USUARIOS_AUTORIZADOS=
# Solo Sandbox: correo de pagador de prueba exigido por Mercado Pago (p. ej. test@testuser.com).
# En PRODUCTION se ignora siempre: se usa el correo real del comprador.
MERCADOPAGO_EMAIL_PAGADOR_PRUEBA=test@testuser.com

# ---------- PRODUCTION (DINERO REAL) ----------
# Panel: Tus integraciones > tu aplicación > Credenciales > selector "Producción" (requiere "Activar ambiente de
# producción"). Si coinciden con las de Sandbox, el backend deshabilita Producción por seguridad.
MERCADOPAGO_PRODUCTION_ACCESS_TOKEN=
MERCADOPAGO_PRODUCTION_PUBLIC_KEY=
MERCADOPAGO_PRODUCTION_WEBHOOK_SECRET=

# Opcionales (tienen valores por defecto en application.properties):
# MERCADOPAGO_API_URL=https://api.mercadopago.com
# MERCADOPAGO_MINUTOS_PAGO=15
# MERCADOPAGO_VALIDACION_3DS=on_fraud_risk
# MERCADOPAGO_WEBHOOK_TOLERANCIA_SEGUNDOS=0

# --- Documento del pagador (payer.identification) ---
# Tipos de documento que se envían a Orders (separados por coma). Por defecto solo DNI: es el único valor que
# aparece en las dos listas de error observadas en Sandbox. El resto de tipos se OMITE (no se cambia por otro).
# MERCADOPAGO_IDENTIFICACION_TIPOS=DNI
# Traducciones explícitas catálogo->Orders, p. ej. C.E=CE. Vacío por defecto: NO hay conversiones automáticas.
# Habilítalo solo si Mercado Pago/soporte lo confirma para tu cuenta.
# MERCADOPAGO_IDENTIFICACION_MAPEO=
