# Copiar como backend/.env.properties y completar SOLO en el equipo local.
# Ejecutar Maven desde backend/ para que Spring encuentre este archivo.
# Este archivo de ejemplo no debe contener valores reales. backend/.env.properties está en .gitignore.

# --- Base de datos (Supabase / PostgreSQL, Transaction Pooler puerto 6543) ---
spring.datasource.url=jdbc:postgresql://aws-0-sa-east-1.pooler.supabase.com:6543/postgres?prepareThreshold=0&sslmode=require
spring.datasource.username=postgres.TU_PROYECTO
spring.datasource.password=REEMPLAZAR_CON_LA_CLAVE_DE_LA_BASE

# --- Seguridad: secretos aleatorios de al menos 32 bytes ---
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
security.jwt.clave-secreta=REEMPLAZAR_CON_UN_SECRETO_ALEATORIO_DE_AL_MENOS_32_BYTES
RESERVA_TOKEN_SECRETO=REEMPLAZAR_CON_UN_SECRETO_ALEATORIO_DE_AL_MENOS_32_BYTES
RECUPERACION_SECRETO=REEMPLAZAR_CON_UN_SECRETO_ALEATORIO_DE_AL_MENOS_32_BYTES

# --- Inicio de sesión con Google (opcional: ya trae el Client ID por defecto; no se usa Client Secret) ---
# google.client-id=634394270803-cq7r95msc42438ja1c5rf68v0ma1251i.apps.googleusercontent.com

# --- Recuperación de contraseña por correo (Resend) ---
RESEND_API_KEY=REEMPLAZAR_CON_TU_API_KEY_DE_RESEND
RESEND_FROM=RutaLibre <no-reply@tu-dominio-verificado.com>

# --- Consulta de DNI (ApiPeru). Solo en el servidor; nunca en variables VITE_* ---
DNI_API_TOKEN=REEMPLAZAR_CON_TU_TOKEN_DE_APIPERU

# ==============================================================================
# Mercado Pago (Checkout API vía Orders). El Access Token NUNCA va al frontend.
# ==============================================================================
# Access Token de PRUEBA (Tus integraciones > Credenciales de prueba). Empieza por APP_USR-.
MERCADOPAGO_ACCESS_TOKEN=REEMPLAZAR_CON_TU_ACCESS_TOKEN_DE_PRUEBA

# Clave secreta de Webhooks (Tus integraciones > Webhooks > Configurar notificaciones).
MERCADOPAGO_WEBHOOK_SECRET=REEMPLAZAR_CON_LA_CLAVE_SECRETA_DE_WEBHOOKS

# Solo Sandbox: correo de pagador de prueba exigido por Mercado Pago (p. ej. test@testuser.com).
# Déjalo vacío en producción para usar el correo real del comprador.
MERCADOPAGO_EMAIL_PAGADOR_PRUEBA=test@testuser.com

# Opcionales (tienen valores por defecto en application.properties):
# MERCADOPAGO_API_URL=https://api.mercadopago.com
# MERCADOPAGO_MINUTOS_PAGO=15
# MERCADOPAGO_VALIDACION_3DS=on_fraud_risk
# MERCADOPAGO_WEBHOOK_TOLERANCIA_SEGUNDOS=0
